# Renpho body-data sync — backend proxy secrets.
#
# Copy this file to `.env.local` for local `vercel dev`, and set the SAME vars in
# the Vercel project's Environment Variables for production. NEVER commit real
# values — `.env*` is git-ignored (this `.env.example` is the only one tracked).

# Your Renpho account login. Held only by the server proxy; never sent to the app.
RENPHO_EMAIL=
RENPHO_PASSWORD=

# Which Renpho cloud to talk to:
#   health  (default) — the current "Renpho Health" app  (cloud.renpho.com, AES-128)
#   classic           — the legacy app                   (renpho.qnclouds.com, RSA)
# Leave blank for `health`. If sign-in fails with "email not registered" on one,
# the account almost certainly lives on the other.
RENPHO_BACKEND=health

# Shared secret gating the public function URL. Generate a long random string
# (e.g. `openssl rand -hex 32`) and paste the SAME value once into the app under
# Settings → Body-data sync. The client sends it as the `x-sync-token` header.
RENPHO_SYNC_TOKEN=

# Optional: pin a specific scale profile's user id. Leave blank to auto-resolve
# (first scale profile, falling back to the account id).
RENPHO_USER_ID=
